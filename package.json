{
  "name": "lingshu-runtime",
  "version": "1.0.7",
  "type": "module",
  "bin": {
    "lingshu": "./dist/index.js",
    "lingshu-runtime": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./card-dsl": {
      "types": "./dist/card-dsl.d.ts",
      "default": "./dist/card-dsl.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lingshu": "node ./dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:check": "npm run build && node scripts/contract-gates/run.mjs",
    "contract:gate": "node scripts/contract-gates/run.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "undici": "^6.0.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "license": "MIT",
  "description": "Lingshu 插件运行时：node:vm 沙箱 + CLI，按统一数据模型执行 .plugin.js（不含任何内容源）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongtong9527/lingshu-runtime.git"
  },
  "homepage": "https://github.com/kongtong9527/lingshu-runtime#readme",
  "bugs": {
    "url": "https://github.com/kongtong9527/lingshu-runtime/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "assets",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ]
}
